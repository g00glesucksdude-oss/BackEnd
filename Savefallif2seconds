local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer

local function getPrimaryPartSafe(char)
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
end

local function createBaseplate(position)
	local baseplate = Instance.new("Part")
	baseplate.Name = "AutoBaseplate_" .. tostring(math.random(1000, 9999))
	baseplate.Size = Vector3.new(100, 1, 100)
	baseplate.Position = position
	baseplate.Anchored = true
	baseplate.BrickColor = BrickColor.new("Bright green")
	baseplate.CanCollide = true
	baseplate.Locked = true
	baseplate.Parent = workspace
	Debris:AddItem(baseplate, 10)
end

local function setup(char)
	local humanoid = char:WaitForChild("Humanoid")
	local isFalling = false
	local fallingTime = 0

	humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Freefall then
			isFalling = true
			fallingTime = 0
		elseif isFalling and newState ~= Enum.HumanoidStateType.Freefall then
			isFalling = false
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if isFalling then
			fallingTime += dt
			if fallingTime > 0.5 then
				local root = getPrimaryPartSafe(char)
				if root then
					createBaseplate(root.Position - Vector3.new(0, 5, 0))
				end
				fallingTime = 0 -- allow multiple baseplates if still falling
			end
		end
	end)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)
